{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forge-viewer",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/view/*", "/"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
